# Copy this file to .env and replace the placeholder values.

# ==========================
# Database
# ==========================
DB_URL=jdbc:postgresql://postgres:5432/flooring
DB_USERNAME=flooring
DB_PASSWORD=your_database_password

# ==========================
# JWT
# ==========================
JWT_SECRET=replace_with_a_long_random_secret

# ==========================
# Admin Account
# ==========================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_secure_password

# ==========================
# Server
# ==========================
SERVER_PORT=8080

# ==========================
# Frontend
# ==========================
CORS_ALLOWED_ORIGINS=https://flooring.shahirjalal.com